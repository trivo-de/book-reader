# Copy to .env and fill in your values. Never commit the real .env.

# Zalo Bot API (required to send messages)
ZALO_URL=https://bot-api.example.com/botTOKEN/sendMessage
ZALO_PHOTO_URL=https://bot-api.example.com/botTOKEN/sendPhoto
ZALO_CHAT_ID=your_chat_id

# Optional: use a local adapter instead of direct Zalo API
# ZALO_ADAPTER_URL=http://localhost:8080

# Google Drive folder ID (destination for uploaded page images)
GDRIVE_FOLDER_ID=your_google_drive_folder_id

# Optional: override data root (default = this project directory)
# DATA_DIR=
